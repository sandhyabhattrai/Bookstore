# Copy to .env and fill in secrets. Never commit .env.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=*

# Postgres (docker-compose `db` service)
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=change-me-too
# POSTGRES_HOST / POSTGRES_PORT only needed outside compose (default: localhost/5432)

# Redis (docker-compose `redis` service)
# REDIS_URL=redis://localhost:6379/0

# Web
WEB_PORT=8000

# S3 uploads (optional; enable with USE_S3=1 + pip packages in requirements.txt)
# USE_S3=1
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
# AWS_LOCATION=books

# hCaptcha bot protection for checkout (optional)
# HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
# HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# Online payments — TEST/sandbox mode by default (no merchant onboarding).
# eSewa UAT values below are officially published test credentials.
# ESEWA_MERCHANT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# ESEWA_FORM_URL=https://rc.esewa.com.np/api/epay/main/v2/form
# ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
# Khalti sandbox: sign up at test-admin.khalti.com (OTP 987654), then set key.
# KHALTI_SECRET_KEY
KHALTI_BASE_URL=https://dev.khalti.com/api/v2/
# PAYMENTS_TEST_MODE=1

